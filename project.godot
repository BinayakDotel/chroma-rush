; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chroma Rush"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.208, 0.149, 0.788, 1)
boot_splash/stretch_mode=1
boot_splash/image="res://icons/splash.png"
config/icon="res://icons/icon_512.png"

[autoload]

Settings="*res://scripts/services/settings.gd"
Profile="*res://scripts/services/profile.gd"
Store="*res://scripts/services/store.gd"
Ads="*res://scripts/services/ads.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

